{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hemlo",
  "version": "../package.json",
  "identifier": "app.hemlo.planner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hemlo",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": null,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://lphysuemxnmcuukzsoya.supabase.co wss://lphysuemxnmcuukzsoya.supabase.co https://world.openfoodfacts.org https://prices.openfoodfacts.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://images.openfoodfacts.org https://static.openfoodfacts.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Hemlo",
    "shortDescription": "A planner for the day, the meals and the shop.",
    "category": "Productivity"
  }
}