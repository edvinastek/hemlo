{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetIt",
  "version": "0.1.0",
  "identifier": "app.getit.planner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GetIt",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://lphysuemxnmcuukzsoya.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "notification": { "all": true }
  }
}
