<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- For xcodebuild -exportArchive in .github/workflows/build.yml. The
	     workflow fills in teamID from the APPLE_TEAM_ID secret, and makes a
	     second copy with destination "upload" that sends the build to App
	     Store Connect (TestFlight). Signing is Apple's cloud-managed
	     distribution certificate, through the App Store Connect API key. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>SET-BY-THE-WORKFLOW</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>testFlightInternalTestingOnly</key>
	<false/>
</dict>
</plist>
