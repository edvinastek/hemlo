<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!--
      allowBackup is off, and the extraction rules exclude everything, because
      this app's local storage holds weight, food and training logs plus a
      signed-in session. Android would otherwise copy them to a Google Drive
      backup or onto a new phone during transfer. The server already holds the
      data; signing in on a new phone brings it back.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:allowBackup">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".PlannerActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!--
              Links from the confirmation and password-reset emails come back
              here: app.getit.planner://auth-callback?code=…
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.getit.planner" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
          The app icons the person can choose (Settings → Looks). Each is a
          launcher entry pointing at the one screen above; exactly one is
          enabled at a time (looks/AppIcons.java), so GetIt is never hidden
          and never shows twice. Classic keeps the name the launcher has
          always known, ".MainActivity", so existing home-screen icons stay.
        -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".PlannerActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNight"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_night"
            android:roundIcon="@mipmap/ic_icon_night"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMono"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_mono"
            android:roundIcon="@mipmap/ic_icon_mono"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBrick"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_brick"
            android:roundIcon="@mipmap/ic_icon_brick"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSage"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_sage"
            android:roundIcon="@mipmap/ic_icon_sage"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconHarbour"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_harbour"
            android:roundIcon="@mipmap/ic_icon_harbour"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconUb"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_ub"
            android:roundIcon="@mipmap/ic_icon_ub"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTick"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_tick"
            android:roundIcon="@mipmap/ic_icon_tick"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconWeek"
            android:targetActivity=".PlannerActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon_week"
            android:roundIcon="@mipmap/ic_icon_week"
            android:label="@string/title_activity_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          The home-screen widget. It shows today's tasks and habits from a copy
          the app keeps on the phone (never from the server directly), and
          ticks made on it go to TickReceiver, which no other app can reach.
        -->
        <receiver
            android:name=".widget.TodayWidget"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widget.TickReceiver"
            android:exported="false" />

        <!--
          The stats widgets (as many as the person places): each shows one saved
          stats view from the copy the app keeps on the phone. The settings
          screen picks the view when one is placed and again from the widget's
          own settings; only the launcher can start it (it is the widget host
          that holds the configure action).
        -->
        <receiver
            android:name=".widget.StatsWidget"
            android:label="@string/widget_stats_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_stats_info" />
        </receiver>
        <activity
            android:name=".widget.StatsWidgetConfigure"
            android:label="@string/widget_stats_choose"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          Barcodes are read by Google's code scanner in Play services, which
          opens its own camera screen and hands back only the number. Asking
          for it here has Google Play fetch the scanner with the app, so the
          first scan does not wait for a download.
        -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Switching between accounts kept on this phone asks for the phone's own
      fingerprint, face or PIN (More → Data → Account). Nothing else uses it.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Reminders are scheduled a few minutes either side of their time, which
      needs no special permission. The notification plugin declares the
      exact-alarm permission on its own; it is removed here so the app never
      asks for it and never has to justify it in Play review.
    -->
    <!--
      The code scanner needs no camera permission, and nothing in GetIt uses
      the camera itself. Removed so no library can add it by the back door.
    -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
</manifest>
