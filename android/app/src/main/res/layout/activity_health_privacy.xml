<?xml version="1.0" encoding="utf-8"?>
<!-- HealthPrivacyActivity: what Visuma does with Health Connect (SLP-05). The
     words match the privacy policy's Health Connect section (src/legal/policy.ts). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="32dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="serif"
            android:text="@string/health_privacy_title"
            android:textColor="@color/widget_ink"
            android:textSize="24sp" />

        <TextView
            style="@style/HealthPrivacyText"
            android:text="@string/health_privacy_what" />
        <TextView
            style="@style/HealthPrivacyText"
            android:text="@string/health_privacy_kept" />
        <TextView
            style="@style/HealthPrivacyText"
            android:text="@string/health_privacy_stop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">
            <Button
                android:id="@+id/health_close"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/health_privacy_close"
                android:textAllCaps="false"
                android:textColor="@color/widget_ink" />
            <Button
                android:id="@+id/health_policy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/health_privacy_policy"
                android:textAllCaps="false"
                android:textColor="@color/widget_accent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
