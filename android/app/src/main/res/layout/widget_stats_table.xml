<?xml version="1.0" encoding="utf-8"?>
<!-- A stats widget showing a short table (WID-10): up to six rows of up to
     three cells, the first row the heading. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/stat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/stat_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/widget_ink_soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stat_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="24sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/trow_0"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_0_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_0_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_0_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/trow_1"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_1_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_1_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_1_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/trow_2"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_2_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_2_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_2_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/trow_3"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_3_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_3_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_3_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/trow_4"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_4_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_4_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_4_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/trow_5"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tcell_5_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_5_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tcell_5_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/stat_asof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
