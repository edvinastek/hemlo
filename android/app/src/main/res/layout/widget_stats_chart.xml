<?xml version="1.0" encoding="utf-8"?>
<!-- A stats widget showing bars or a line (WID-10): name, the figure with its
     line beside it, then the chart, drawn by StatsCharts in layers that are
     painted in the theme's colours. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/stat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/stat_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/widget_ink_soft"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/text_col"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/stat_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/stat_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/widget_ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/chart_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="6dp">
            <ImageView
                android:id="@+id/chart_soft"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/chart_accent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/chart_colour"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/stat_asof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
