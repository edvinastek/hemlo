<?xml version="1.0" encoding="utf-8"?>
<!-- The widget as the picker shows it on Android 12 and later: invented sample
     rows, drawn by the phone in its own light or dark colours. Keep it in step
     with widget_today.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Friday 25 September"
            android:textColor="@color/widget_ink"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="3 left"
            android:textColor="@color/widget_ink_soft"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="2dp"
        android:background="@color/widget_rule" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_ink_soft"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:contentDescription="@string/widget_tick"
            android:src="@drawable/widget_tick_off" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="11:00"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Team check-in"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:contentDescription="@string/widget_tick"
            android:src="@drawable/widget_tick_off" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="17:30"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Calisthenics A"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:contentDescription="@string/widget_tick"
            android:src="@drawable/widget_tick_off" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="18:30"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Groceries for the week"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="Habits"
        android:textAllCaps="true"
        android:textColor="@color/widget_ink_soft"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:contentDescription="@string/widget_tick"
            android:src="@drawable/widget_tick_on" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text=""
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="Stretch 10 min"
            android:textColor="@color/widget_ink_soft"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:contentDescription="@string/widget_tick"
            android:src="@drawable/widget_tick_off" />
        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text=""
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="10,000 steps"
            android:textColor="@color/widget_ink"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
