<?xml version="1.0" encoding="utf-8"?>
<!-- Sleep from Health Connect (SLP-05): the screen Health Connect opens from
     its permission screen and its settings (health/HealthPrivacyActivity). -->
<resources>
    <string name="health_privacy_title">Hemlo and Health Connect</string>
    <string name="health_privacy_what">Hemlo reads one thing from Health Connect: your sleep sessions, with the sleep stages when there are any. It reads them only when you choose Import from Health Connect on the Sleep page, and only for the days you pick.</string>
    <string name="health_privacy_kept">Each night it imports becomes a night on the Sleep page, kept with the rest of your Hemlo data in your account so it is on your other devices too. Hemlo never writes to Health Connect, never reads anything else from it, and never shares, sells or advertises with what it reads.</string>
    <string name="health_privacy_stop">You can take the permission back at any time in Health Connect. Nights already imported stay in Hemlo until you delete them.</string>
    <string name="health_privacy_policy">Privacy policy</string>
    <!-- The public privacy policy, the same one given in Play Console
         (https://<site-name>.netlify.app/privacy.html). Health Connect asks
         that this screen lead to it. Empty: the button opens the same policy
         inside the app (More → About → Privacy policy). -->
    <string name="health_privacy_url" translatable="false"></string>
    <string name="health_privacy_close">Close</string>

    <style name="HealthPrivacy" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/widget_paper</item>
        <item name="android:statusBarColor">@color/widget_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="HealthPrivacyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
